{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/report", "destination": "/api/weekly" },
    { "source": "/reports", "destination": "/api/reports" },
    { "source": "/trends", "destination": "/api/trends" }
  ],
  "crons": [
    { "path": "/api/cron/reset", "schedule": "5 22 * * *" },
    { "path": "/api/cron/report", "schedule": "0 4 * * 6" }
  ]
}
