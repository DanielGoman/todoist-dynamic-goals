# Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=

# From your app in the Todoist App Management Console
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Any long random string; protects /api/oauth/start and /api/recompute
SETUP_KEY=

# Any long random string; Vercel sends it to the cron endpoint automatically
CRON_SECRET=

# Optional
# GOAL_MODE=ratchet          # ratchet (default): goal only rises during the day | live: always exact
# INCLUDE_OVERDUE=true       # count overdue tasks in the daily and weekly goals (default: excluded)
# TODOIST_USER_ID=51404325   # ignore webhook events for any other user
# TIMEZONE=Asia/Jerusalem    # fallback if Todoist doesn't return one
